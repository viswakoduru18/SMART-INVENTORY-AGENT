# ---- Database (PostgreSQL in production; SQLite default for local trials)
DATABASE_URL=postgresql+psycopg2://smart_inventory:change-me@db:5432/smart_inventory

# ---- ERP connection (see config/erp.yaml for endpoint + field mapping)
ERP_CONNECTOR=rest            # rest | csv | mock
ERP_BASE_URL=https://erp.acintyo.internal
ERP_API_TOKEN=
# ERP_API_KEY=
# ERP_USERNAME=
# ERP_PASSWORD=

# ---- API security: comma separated key:role (roles: admin, procurement, management, portal, erp)
API_KEYS=replace-with-admin-key:admin,replace-with-procurement-key:procurement,replace-with-mgmt-key:management,replace-with-portal-key:portal,replace-with-erp-key:erp

# ---- Claude agent layer (optional: the platform runs without it)
ANTHROPIC_API_KEY=
LLM_ENABLED=true
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_FALLBACKS=true

# ---- WhatsApp Business API (Gupshup / AiSensy webhook). Empty = messages are logged, not sent.
WHATSAPP_WEBHOOK_URL=
WHATSAPP_API_KEY=
PROCUREMENT_WHATSAPP=+91XXXXXXXXXX

# ---- Scheduler (run in exactly one process: the `scheduler` service in docker-compose)
SCHEDULER_ENABLED=false
TIMEZONE=Asia/Kolkata
ML_THREADS=1                  # cap sklearn/OpenMP threads for the forecast models
